# Manheim Credentials
MANHEIM_USERNAME=your_username_here
MANHEIM_PASSWORD=your_password_here

# Bright Data Browser API (Puppeteer/Playwright)
BROWSER_WSS_ENDPOINT=wss://brd-customer-hl_XXXXXXX-zone-XXXXX:your_password@brd.superproxy.io:9222

# Target URLs
AUTH_URL=https://auth.manheim.com/as/authorization.oauth2?response_type=code&state=%2Fresults&scope=email+profile+openid+offline_access&adaptor=manheim_customer&client_id=25xk9b3322exa7ar4tdazrr4&redirect_uri=https%3A%2F%2Fsearch.manheim.com%2Fcallback#/?filters=VehicleSubTypes:00000000-0000-1000-0000-000100000001
RESULTS_URL=https://search.manheim.com/results#/results/your-search-id-here

# Vehicle filters (comma-separated)
VEHICLE_MAKES=Honda,Toyota
